# Copiá este archivo a .env y completalo. La API valida todo al arrancar
# (src/config/env.ts) y no levanta si falta algo obligatorio.
# Las variables de servicios externos son opcionales en desarrollo y
# obligatorias en producción (NODE_ENV=production).

# --- General ---
NODE_ENV=development
PORT=4000
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Base de datos ---
# La de docker-compose.yml: `docker compose up -d`
DATABASE_URL=postgresql://app:app@localhost:5435/app
# Base de los e2e (pnpm test:e2e): se crea sola y se vacía en cada test. Tiene que terminar en _test
DATABASE_URL_TEST=postgresql://app:app@localhost:5435/app_test

# --- Plataforma ---
# Nombre provisorio: nunca escribirlo fijo en el código
PLATFORM_NAME=
# Solo el dominio, sin protocolo. Las tiendas quedan en <slug>.<PLATFORM_DOMAIN>
PLATFORM_DOMAIN=localhost
# URL del front (market-front), para los links de los emails
FRONT_URL=http://localhost:3000

# --- Login ---
# Mínimo 32 caracteres. Generalo con: openssl rand -base64 48
JWT_SECRET=

# --- Almacenamiento de imágenes (Supabase Storage, protocolo S3) ---
# Todo sale de Supabase: Project Settings → Storage → S3 Connection.
# Sin STORAGE_ENDPOINT se usa AWS S3.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Bucket público
STORAGE_BUCKET=
# https://<ref>.supabase.co/storage/v1/object/public/<bucket>
STORAGE_PUBLIC_URL=

# --- Resend (recuperar contraseña) ---
RESEND_API_KEY=
# Ej.: Nombre <no-responder@dominio>
EMAIL_FROM=

# --- Vercel (dominios propios; opcional) ---
VERCEL_TOKEN=
# Obligatorio si hay VERCEL_TOKEN
VERCEL_PROJECT_ID=
# Solo si el proyecto está en un equipo de Vercel
VERCEL_TEAM_ID=

# --- Seed (pnpm prisma db seed); la API no las usa ---
# Usuario ADMIN (Piter). Contraseña de al menos 12 caracteres
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Fabricante de la marca de prueba (solo fuera de producción; si faltan, no se crea)
SEED_FABRICANTE_EMAIL=
SEED_FABRICANTE_PASSWORD=
